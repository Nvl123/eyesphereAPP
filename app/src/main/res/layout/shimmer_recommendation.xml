<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_recommendation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:shimmer_duration="1200"
        app:shimmer_auto_start="true"
        app:shimmer_direction="left_to_right"
        app:shimmer_repeat_count="1000"
        app:shimmer_repeat_delay="0"
        app:shimmer_intensity="0.9"
        app:shimmer_dropoff="0.4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Baris pertama recommendation shimmer -->
            <View
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/shimmer_background" />

            <!-- Baris kedua recommendation shimmer -->
            <View
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_weight="0.9"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/shimmer_background" />

            <!-- Baris ketiga recommendation shimmer -->
            <View
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_weight="0.8"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/shimmer_background" />

            <!-- Baris keempat recommendation shimmer -->
            <View
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_weight="0.7"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="32dp"
                android:background="@drawable/shimmer_background" />

            <!-- Baris kelima recommendation shimmer -->
            <View
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_weight="0.5"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="48dp"
                android:background="@drawable/shimmer_background" />

        </LinearLayout>

    </com.facebook.shimmer.ShimmerFrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
