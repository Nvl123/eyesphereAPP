<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_gravity="center"
    android:background="#00FFFFFF">

    <androidx.cardview.widget.CardView
        android:layout_width="50dp"
        android:layout_height="300dp"
        android:layout_gravity="center"
        android:elevation="4dp"
        android:padding="16dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="90dp"
        android:layout_marginStart="30dp"
        app:cardBackgroundColor="#00FFFFFF">

        <com.google.android.material.slider.Slider
            android:id="@+id/slider"
            android:layout_width="250dp"
            android:layout_height="300dp"
            android:layout_gravity="center_horizontal|center"
            android:orientation="vertical"
            android:rotation="270"
            android:value="90"
            android:valueFrom="0"
            android:valueTo="100"
            app:haloColor="#6D7C70"
            app:labelBehavior="gone"
            app:thumbColor="?attr/colorPrimary"
            app:trackColorActive="?attr/colorPrimary"
            app:trackColorInactive="#7E7BA888"/>

        <ImageView
            android:id="@+id/high_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/proicons_brightness"
            android:layout_gravity="center_horizontal|top"/>

        <ImageView
            android:id="@+id/low_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/brignesslow"
            android:layout_gravity="center_horizontal|bottom"/>
    </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
