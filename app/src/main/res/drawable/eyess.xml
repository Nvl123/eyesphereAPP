<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shadow/outline mata -->
    <item android:top="2dp" android:left="2dp">
        <shape android:shape="oval">
            <solid android:color="#40000000"/>
            <size android:width="120dp" android:height="80dp"/>
        </shape>
    </item>

    <!-- Bentuk mata utama -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#FFFFFF"
                android:centerColor="#F0F8FF"
                android:endColor="#E6F3FF"
                android:angle="270"/>
            <stroke android:width="2dp" android:color="#4A90E2"/>
            <size android:width="120dp" android:height="80dp"/>
        </shape>
    </item>

    <!-- Iris mata -->
    <item
        android:top="15dp"
        android:bottom="15dp"
        android:left="25dp"
        android:right="25dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#2E8B57"
                android:centerColor="#3CB371"
                android:endColor="#20B2AA"
                android:angle="45"/>
            <stroke android:width="1dp" android:color="#1F4E79"/>
        </shape>
    </item>

    <!-- Pupil -->
    <item
        android:top="30dp"
        android:bottom="30dp"
        android:left="50dp"
        android:right="50dp">
        <shape android:shape="oval">
            <solid android:color="#000000"/>
        </shape>
    </item>

    <!-- Highlight pupil -->
    <item
        android:top="32dp"
        android:bottom="42dp"
        android:left="52dp"
        android:right="62dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF"/>
        </shape>
    </item>


</layer-list>